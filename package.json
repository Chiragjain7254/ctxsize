{
  "name": "@chiragjain7254/ctxsize",
  "version": "0.1.0",
  "description": "See what every coding agent loads before your first prompt, in tokens, and what each one silently drops.",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "gemini-cli",
    "agents-md",
    "context",
    "tokens",
    "skills",
    "cli"
  ],
  "license": "MIT",
  "author": "Chirag Jain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chiragjain7254/ctxsize.git"
  },
  "homepage": "https://github.com/Chiragjain7254/ctxsize#readme",
  "bugs": "https://github.com/Chiragjain7254/ctxsize/issues",
  "type": "module",
  "bin": {
    "ctxsize": "dist/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:gen": "node --experimental-strip-types scripts/secret-word.ts",
    "study": "node scripts/study.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "yaml": "^2.9.1"
  }
}
