{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chiragjain7254/ctxsize/main/schema/ctxsize.schema.json",
  "title": "ctxsize.json",
  "description": "Configuration for ctxsize: your own tools, models, exclusions and budgets. See docs/CONFIG.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Points editors at this schema. ctxsize ignores it."
    },
    "messages": {
      "type": "integer",
      "minimum": 1,
      "description": "Messages assumed for the overhead cost estimate (default 50). --messages wins."
    },
    "exclude": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relativeGlob" },
      "description": "Globs of files to leave out of every scan, as if they did not exist. Same as --exclude."
    },
    "tools": {
      "type": "object",
      "description": "Tools by id (lowercase letters, digits, dashes). A new id defines a tool; the id of a built-in data-driven tool overrides fields of it; the id of a built-in tool with its own loader (claude, codex, cursor, copilot, gemini) accepts only model and maxTokens.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,39}$" },
      "additionalProperties": { "$ref": "#/$defs/tool" }
    },
    "models": {
      "type": "object",
      "description": "Models by id. An id that matches a built-in preset overrides fields of that preset.",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,59}$" },
      "additionalProperties": { "$ref": "#/$defs/model" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "relativeGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).*$",
      "description": "Relative to the repo, \"/\" as the separator, no \"..\". *, **, ? and {a,b} work."
    },
    "positiveInt": { "type": "integer", "minimum": 1 },
    "tool": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Name shown in reports. Required for a new tool."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model id from \"models\" or a built-in preset."
        },
        "maxTokens": {
          "$ref": "#/$defs/positiveInt",
          "description": "Startup token budget for this tool. ctxsize exits 1 when the tool loads more."
        },
        "defaultContextTokens": {
          "$ref": "#/$defs/positiveInt",
          "description": "Context window when the model does not set one."
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativeGlob" },
          "description": "File names or globs, relative to each searched folder. Plain names match with exact case."
        },
        "search": {
          "enum": ["root-to-cwd", "cwd", "root", "nearest"],
          "description": "Which folders are searched for instruction files."
        },
        "firstMatchOnly": {
          "type": "boolean",
          "description": "In each folder only the first pattern that matches loads."
        },
        "nested": {
          "enum": ["on-demand", "ignore"],
          "description": "Same-named files below the working folder."
        },
        "instructionLoad": {
          "enum": ["startup", "on-demand"],
          "description": "When instruction files load."
        },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "skills": {
          "type": "object",
          "properties": {
            "dirs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativeGlob" } }
          },
          "additionalProperties": false,
          "description": "Folders holding <skill>/SKILL.md. Their name and description entries load at startup."
        },
        "limits": { "$ref": "#/$defs/limits" },
        "sources": { "$ref": "#/$defs/sources" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["dir"],
      "properties": {
        "dir": {
          "$ref": "#/$defs/relativeGlob",
          "description": "Rules folder, from the repo root."
        },
        "glob": {
          "$ref": "#/$defs/relativeGlob",
          "description": "Which files inside it are rules (default: every .md)."
        },
        "load": { "enum": ["startup", "on-demand"] },
        "modeKey": {
          "type": "string",
          "minLength": 1,
          "description": "Frontmatter key that picks the mode, such as trigger."
        },
        "startupModes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Values of modeKey that load at startup."
        },
        "conditionalKey": {
          "type": "string",
          "minLength": 1,
          "description": "Frontmatter key that makes a rule on-demand, such as paths."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxFileBytes": { "$ref": "#/$defs/positiveInt" },
        "maxTotalBytes": { "$ref": "#/$defs/positiveInt" },
        "maxFileChars": { "$ref": "#/$defs/positiveInt" },
        "skillListingMaxBytes": { "$ref": "#/$defs/positiveInt" },
        "skillDescriptionMaxChars": { "$ref": "#/$defs/positiveInt" },
        "recommendedMaxLines": { "$ref": "#/$defs/positiveInt" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "checked"],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://",
            "description": "The official docs the number comes from."
          },
          "checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "note": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "contextTokens": { "$ref": "#/$defs/positiveInt" },
        "tokenizer": {
          "oneOf": [
            { "enum": ["o200k_base", "cl100k_base"] },
            {
              "type": "object",
              "required": ["charsPerToken"],
              "properties": {
                "charsPerToken": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
