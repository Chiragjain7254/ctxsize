{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chiragjain7254/ctxsize/blob/main/docs/report.schema.json",
  "title": "ctxsize report",
  "description": "The output of `ctxsize --json` (schemaVersion 2). `--history --json` has a different shape and is not described here.",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "generatedAt",
    "root",
    "messages",
    "price",
    "agents",
    "checks",
    "hidden",
    "tokensAreEstimates",
    "grade"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "ctxsize" },
        "version": { "type": "string", "description": "The ctxsize version that wrote the report." }
      },
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC time of the run. SOURCE_DATE_EPOCH pins it."
    },
    "root": { "const": ".", "description": "Always \".\" so reports do not leak local paths." },
    "messages": {
      "type": "integer",
      "minimum": 1,
      "description": "Messages assumed for every tool's overhead figure."
    },
    "price": {
      "type": ["object", "null"],
      "description": "The price from --price, or null. ctxsize has no prices of its own: without --price there is no cost anywhere in the report.",
      "required": ["amount", "per", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "per": {
          "type": "integer",
          "minimum": 1,
          "description": "Tokens the amount is for (1000000 by default)."
        },
        "currency": { "type": "string", "minLength": 1, "maxLength": 8 }
      },
      "additionalProperties": false
    },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
    "hidden": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ids of tools left out of `agents` because they load nothing (see --all)."
    },
    "tokensAreEstimates": { "type": "boolean" },
    "grade": {
      "type": "object",
      "description": "Context health grade (rules: docs/GRADE.md). Computed from the same problems as the Fix list.",
      "required": ["overall", "agents"],
      "properties": {
        "overall": {
          "anyOf": [{ "$ref": "#/$defs/grade" }, { "type": "null" }],
          "description": "Null when no agent loads anything."
        },
        "agents": { "type": "object", "additionalProperties": { "$ref": "#/$defs/grade" } }
      },
      "additionalProperties": false
    },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "tree": {
      "type": "array",
      "description": "Only with --tree: startup tokens per tool when the agent starts in each folder.",
      "items": {
        "type": "object",
        "required": ["dir", "tools"],
        "properties": {
          "dir": { "type": "string" },
          "tools": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
        },
        "additionalProperties": false
      }
    },
    "diff": {
      "type": "object",
      "description": "Only with --diff: the comparison with another git ref."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "grade": {
      "type": "object",
      "required": ["letter", "score", "bad", "warn"],
      "properties": {
        "letter": { "enum": ["A", "B", "C", "D", "F"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "bad": { "type": "integer", "minimum": 0, "description": "Things cut off or left out." },
        "warn": { "type": "integer", "minimum": 0, "description": "Other things worth fixing." }
      },
      "additionalProperties": false
    },
    "category": { "enum": ["instructions", "rules", "skills", "memory"] },
    "agent": {
      "type": "object",
      "required": [
        "agent",
        "label",
        "model",
        "contextTokens",
        "notes",
        "startup",
        "usage",
        "topFiles",
        "onDemand",
        "items",
        "drops",
        "warnings",
        "tokenCounts"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "description": "Tool id, such as claude or a tool from ctxsize.json."
        },
        "label": { "type": "string" },
        "model": {
          "type": "object",
          "required": ["id", "label", "contextTokens", "tokenizer", "exactTokenizer", "isDefault"],
          "properties": {
            "id": { "type": "string" },
            "label": { "type": "string" },
            "contextTokens": {
              "type": ["integer", "null"],
              "minimum": 1,
              "description": "null when the official docs do not state the window."
            },
            "tokenizer": { "type": "string" },
            "exactTokenizer": { "type": "boolean" },
            "isDefault": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "contextTokens": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "null when the window is unknown."
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "startup": {
          "type": "object",
          "required": ["total", "byCategory"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "byCategory": {
              "type": "object",
              "required": ["instructions", "rules", "skills", "memory"],
              "properties": {
                "instructions": { "type": "integer", "minimum": 0 },
                "rules": { "type": "integer", "minimum": 0 },
                "skills": { "type": "integer", "minimum": 0 },
                "memory": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "required": ["startupPctOfContext", "messages", "overheadTokens", "overheadCost"],
          "properties": {
            "startupPctOfContext": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "null when the window is unknown."
            },
            "messages": { "type": "integer", "minimum": 1 },
            "overheadTokens": { "type": "integer", "minimum": 0 },
            "overheadCost": {
              "type": ["number", "null"],
              "minimum": 0,
              "description": "In the currency of `price`; null when no --price was given."
            }
          },
          "additionalProperties": false
        },
        "topFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "tokens", "category"],
            "properties": {
              "path": { "type": "string" },
              "tokens": { "type": "integer", "minimum": 0 },
              "category": { "$ref": "#/$defs/category" },
              "skill": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "onDemand": {
          "type": "object",
          "required": ["total", "count"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "drops": { "type": "array", "items": { "$ref": "#/$defs/drop" } },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["message"],
            "properties": {
              "agent": { "type": "string" },
              "path": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "mcp": { "$ref": "#/$defs/mcp" },
        "tokenCounts": { "enum": ["exact", "estimate"] }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "agent",
        "path",
        "scope",
        "bytes",
        "category",
        "load",
        "reason",
        "order",
        "tokens"
      ],
      "properties": {
        "agent": { "type": "string" },
        "path": {
          "type": "string",
          "description": "POSIX path relative to the repo; user files start with ~/."
        },
        "scope": { "enum": ["project", "user"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "category": { "$ref": "#/$defs/category" },
        "load": { "enum": ["startup", "on-demand", "ignored"] },
        "reason": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "importedFrom": { "type": "string" },
        "skill": {
          "type": "object",
          "required": ["name", "description", "bodyPath"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "whenToUse": { "type": "string" },
            "bodyPath": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "drop": {
      "type": "object",
      "required": ["agent", "kind", "certainty", "limit"],
      "properties": {
        "agent": { "type": "string" },
        "kind": {
          "enum": [
            "file-truncated",
            "file-dropped",
            "import-too-deep",
            "skill-description-truncated",
            "skill-description-dropped",
            "skill-omitted",
            "over-recommended-size",
            "legacy"
          ]
        },
        "certainty": { "enum": ["will", "at-risk", "advice"] },
        "path": { "type": "string" },
        "skill": { "type": "string" },
        "bytesLost": { "type": "integer", "minimum": 0 },
        "tokensLost": { "type": "integer", "minimum": 0 },
        "limit": {
          "type": "string",
          "description": "Profile key of the limit, such as codex.projectDocMaxBytes."
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["kind", "code", "severity", "message", "paths"],
      "properties": {
        "tool": { "type": "string" },
        "kind": { "enum": ["duplicate", "suggestion", "skill-health"] },
        "code": { "type": "string" },
        "severity": { "enum": ["info", "warn"] },
        "message": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "required": ["servers", "measuredTokens"],
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "transport", "configPath", "status"],
            "properties": {
              "name": { "type": "string" },
              "transport": { "enum": ["stdio", "remote"] },
              "configPath": { "type": "string" },
              "status": { "enum": ["not-measured", "measured", "failed", "remote-skipped"] },
              "tools": { "type": "integer", "minimum": 0 },
              "tokens": { "type": "integer", "minimum": 0 },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "measuredTokens": { "type": ["integer", "null"], "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
